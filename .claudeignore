# Keep Claude's context lean: skip generated, vendored and bulky files
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.git/

# Secrets
.env
.env.*

# Scan output & logs (can be huge)
output/
results/
*.log
*.json.gz
*.jsonl

# Wordlists / large data
wordlists/
*.txt.gz
